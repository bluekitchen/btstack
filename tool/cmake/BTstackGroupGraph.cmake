# Export the complete resolver group graph without configuring a port:
#   cmake -DOUTPUT_FILE=groups.dot -P tool/cmake/BTstackGroupGraph.cmake
# Render separately with: dot -Tsvg groups.dot -o groups.svg
cmake_minimum_required(VERSION 3.16)

get_filename_component(BTSTACK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/BTstack.cmake")

if(NOT OUTPUT_FILE)
    set(OUTPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/btstack-groups.dot")
endif()

set(graph "digraph btstack_groups {\n  rankdir=LR;\n  graph [label=\"BTstack resolver groups (arrows point to requirements)\", labelloc=t];\n  node [shape=box];\n")
list(REMOVE_DUPLICATES btstack_source_groups)
list(SORT btstack_source_groups)
foreach(group IN LISTS btstack_source_groups)
    string(REPLACE "-" "_" suffix "${group}")
    if(group STREQUAL "core-le" OR group STREQUAL "core-classic")
        string(APPEND graph "  \"${group}\" [style=dashed];\n")
    else()
        string(APPEND graph "  \"${group}\";\n")
    endif()
    foreach(dependency IN LISTS btstack_group_dependencies_${suffix})
        if(NOT dependency IN_LIST btstack_source_groups)
            message(FATAL_ERROR "Unknown dependency '${dependency}' of group '${group}'")
        endif()
        string(APPEND graph "  \"${group}\" -> \"${dependency}\";\n")
    endforeach()
    foreach(requirement IN LISTS btstack_group_configuration_requirements_${suffix})
        string(APPEND graph "  \"${requirement}\" [shape=ellipse, style=dashed];\n")
        string(APPEND graph "  \"${group}\" -> \"${requirement}\" [style=dashed];\n")
    endforeach()
endforeach()
string(APPEND graph "}\n")
file(WRITE "${OUTPUT_FILE}" "${graph}")
message(STATUS "Wrote BTstack group dependencies to ${OUTPUT_FILE}")

if(SVG_FILE)
    find_program(BTSTACK_GRAPHVIZ_DOT dot)
    if(NOT BTSTACK_GRAPHVIZ_DOT)
        message(FATAL_ERROR "SVG_FILE requires Graphviz's dot executable; DOT output is available at ${OUTPUT_FILE}")
    endif()
    execute_process(COMMAND "${BTSTACK_GRAPHVIZ_DOT}" -Tsvg "${OUTPUT_FILE}" -o "${SVG_FILE}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Graphviz failed: ${result}")
    endif()
    message(STATUS "Wrote BTstack group diagram to ${SVG_FILE}")
endif()
