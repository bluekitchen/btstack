# Print a BTstack library's configure-time selection and generated target data.
cmake_minimum_required(VERSION 3.18)
if(NOT INFO_DIRECTORY OR NOT INFO_REGISTRY)
    message(FATAL_ERROR "BTstack library info requires INFO_DIRECTORY and INFO_REGISTRY")
endif()
include("${INFO_REGISTRY}")
if(DEFINED ENV{LIBRARY} AND NOT "$ENV{LIBRARY}" STREQUAL "")
    set(library "$ENV{LIBRARY}")
else()
    list(LENGTH BTSTACK_INFO_LIBRARIES library_count)
    if(NOT library_count EQUAL 1)
        message(FATAL_ERROR "Set LIBRARY to a BTstack library name. Available: ${BTSTACK_INFO_LIBRARIES}")
    endif()
    list(GET BTSTACK_INFO_LIBRARIES 0 library)
endif()
if(NOT library IN_LIST BTSTACK_INFO_LIBRARIES)
    message(FATAL_ERROR "Unknown BTstack library '${library}'. Available: ${BTSTACK_INFO_LIBRARIES}")
endif()
string(SHA256 info_key "${library}")
include("${INFO_DIRECTORY}/${info_key}.cmake")

function(print_list label)
    message(STATUS "${label}:")
    if(ARGN)
        foreach(item IN LISTS ARGN)
            message(STATUS "  ${item}")
        endforeach()
    else()
        message(STATUS "  (none)")
    endif()
endfunction()

message(STATUS "BTstack library: ${BTSTACK_LIBRARY_NAME}")
message(STATUS "Configuration header: ${BTSTACK_LIBRARY_CONFIG}")
print_list("Requested groups" ${BTSTACK_LIBRARY_REQUESTED_GROUPS})
print_list("Resolved groups" ${BTSTACK_LIBRARY_RESOLVED_GROUPS})
print_list("Required configuration macros" ${BTSTACK_LIBRARY_REQUIREMENTS})
print_list("Detected configuration macros" ${BTSTACK_LIBRARY_CONFIG_MACROS})
print_list("Target sources" ${BTSTACK_LIBRARY_SOURCES})
print_list("Target include directories" ${BTSTACK_LIBRARY_INCLUDES})
print_list("Consumer include directories" ${BTSTACK_LIBRARY_CONSUMER_INCLUDES})
