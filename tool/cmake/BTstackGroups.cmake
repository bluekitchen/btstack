# List or inspect source groups without configuring a port.
# cmake -DMODE=list [-DFILTER=uart] -P tool/cmake/BTstackGroups.cmake
# cmake -DMODE=info -DGROUP=gatt-server -P tool/cmake/BTstackGroups.cmake
cmake_minimum_required(VERSION 3.18)
include("${CMAKE_CURRENT_LIST_DIR}/BTstack.cmake")

# Marker groups are internal resolver metadata, not source groups to select.
set(selectable_groups ${btstack_source_groups})
list(REMOVE_ITEM selectable_groups core-classic core-le)
list(REMOVE_DUPLICATES selectable_groups)
list(SORT selectable_groups)

function(group_category output group)
    if(group MATCHES "^platform-")
        set(category "Platform")
    elseif(group MATCHES "^chipset-")
        set(category "Chipsets")
    elseif(group MATCHES "^transport-")
        set(category "Transports")
    elseif(group MATCHES "^(third-party-|lwip-|lc3$)")
        set(category "Third-party and networking")
    elseif(group MATCHES "^(classic|a2dp|avrcp|avdtp|avctp|bnep|hfp|hsp|hid|pbap|rfcomm|sdp|spp)")
        set(category "Classic Bluetooth")
    elseif(group MATCHES "^(ble|le-|gatt|att-|sm-|mesh)")
        set(category "LE, GATT and Mesh")
    elseif(group MATCHES "(^core$|^l2cap$|^audio-|^tlv-)")
        set(category "Core and utilities")
    else()
        set(category "Other")
    endif()
    set(${output} "${category}" PARENT_SCOPE)
endfunction()

function(print_list label)
    message("${label}:")
    if(ARGN)
        foreach(item IN LISTS ARGN)
            message("  ${item}")
        endforeach()
    else()
        message("  (none)")
    endif()
endfunction()

# Curated descriptions for common entry points. Groups without a description
# still report their exact catalog and resolver metadata.
set(description_core "Shared BTstack runtime and HCI implementation")
set(description_ble "Bluetooth Low Energy host and security manager")
set(description_gatt_server "GATT server and ATT request handling")
set(description_gatt_client "GATT client procedures")
set(description_transport_h4 "HCI H4 UART transport")
set(description_transport_h5 "HCI H5 reliable UART transport")
set(description_platform_posix_run_loop "POSIX event loop")
set(description_platform_embedded_run_loop "Event loop for embedded systems")
set(description_platform_posix_uart "POSIX UART driver")
set(description_le_device_db_memory "In-memory LE bonding database")
set(description_le_device_db_tlv "TLV-backed LE bonding database")
set(description_third_party_rijndael "Software AES implementation")

if(NOT DEFINED MODE OR MODE STREQUAL "list")
    string(TOLOWER "${FILTER}" filter_lower)
    foreach(group IN LISTS selectable_groups)
        string(TOLOWER "${group}" group_lower)
        string(FIND "${group_lower}" "${filter_lower}" filter_index)
        if(NOT filter_index EQUAL -1)
            group_category(category "${group}")
            list(APPEND matching_${category} "${group}")
        endif()
    endforeach()
    set(found FALSE)
    foreach(category IN ITEMS "Core and utilities" "LE, GATT and Mesh" "Classic Bluetooth"
            "Transports" "Platform" "Chipsets" "Third-party and networking" "Other")
        if(matching_${category})
            set(found TRUE)
            print_list("${category}" ${matching_${category}})
        endif()
    endforeach()
    if(NOT found)
        message("No groups match '${FILTER}'.")
    endif()
elseif(MODE STREQUAL "info")
    if(NOT GROUP)
        message(FATAL_ERROR "Set GROUP to a source group, for example -DGROUP=gatt-server")
    endif()
    if(NOT GROUP IN_LIST selectable_groups)
        message(FATAL_ERROR "Unknown BTstack source group '${GROUP}'. Use -DMODE=list to list groups.")
    endif()
    string(REPLACE "-" "_" suffix "${GROUP}")
    group_category(category "${GROUP}")
    btstack_resolve_groups(resolved GROUPS "${GROUP}")
    btstack_collect_group_configuration_requirements(requirements GROUPS "${GROUP}")
    message("Group: ${GROUP}")
    message("Category: ${category}")
    if(DEFINED description_${suffix})
        message("Description: ${description_${suffix}}")
    endif()
    print_list("Direct dependencies (including internal configuration markers)" ${btstack_group_dependencies_${suffix}})
    print_list("Resolved source groups" ${resolved})
    print_list("Required configuration macros" ${requirements})
    print_list("Sources in this group (relative to BTstack root)" ${btstack_sources_${suffix}})
    print_list("Consumer include directories (relative to BTstack root)" ${btstack_consumer_include_directories_${suffix}})
else()
    message(FATAL_ERROR "Unknown MODE '${MODE}'; use list or info")
endif()
