# Display configure-time BTstack port and example selection information.

if(NOT DEFINED INFO_FILE)
    message(FATAL_ERROR "BTstack info requires INFO_FILE")
endif()
include("${INFO_FILE}")

if(INFO_MODE STREQUAL "port")
    message(STATUS "BTstack port: ${BTSTACK_INFO_PORT}")
    message(STATUS "Configuration macros: ${BTSTACK_INFO_CONFIGURATION_MACROS}")
    if(BTSTACK_INFO_CAPABILITIES)
        message(STATUS "Port capabilities: ${BTSTACK_INFO_CAPABILITIES}")
    else()
        message(STATUS "Port capabilities: (none)")
    endif()
    return()
endif()

if(INFO_MODE STREQUAL "list-applications")
    foreach(application IN LISTS BTSTACK_INFO_EXAMPLES)
        message(STATUS "${application}")
    endforeach()
    return()
endif()

if(NOT INFO_MODE STREQUAL "example" AND NOT INFO_MODE STREQUAL "application" AND NOT INFO_MODE STREQUAL "manifest")
    message(FATAL_ERROR "Unknown BTstack info mode: ${INFO_MODE}")
endif()

if(INFO_MODE STREQUAL "application" OR INFO_MODE STREQUAL "manifest")
    if(NOT DEFINED ENV{APPLICATION} OR "$ENV{APPLICATION}" STREQUAL "")
        message(FATAL_ERROR "Set APPLICATION when building application-info")
    endif()
    set(example "$ENV{APPLICATION}")
elseif(NOT DEFINED ENV{EXAMPLE} OR "$ENV{EXAMPLE}" STREQUAL "")
    message(FATAL_ERROR
        "Set EXAMPLE when building example-info, for example:\n"
        "  EXAMPLE=gatt_counter cmake --build <build-dir> --target example-info")
else()
    set(example "$ENV{EXAMPLE}")
endif()
list(FIND BTSTACK_INFO_EXAMPLES "${example}" example_index)
if(example_index EQUAL -1)
    message(FATAL_ERROR "Unknown BTstack application '${example}'")
endif()

string(REPLACE "-" "_" example_suffix "${example}")
set(status_variable "BTSTACK_INFO_${example_suffix}_STATUS")
if(INFO_MODE STREQUAL "manifest")
    if(NOT ${status_variable})
        message(FATAL_ERROR "BTstack application '${example}' is excluded for port ${BTSTACK_INFO_PORT}")
    endif()
    if(NOT OUTPUT_FILE)
        message(FATAL_ERROR "Manifest export requires OUTPUT_FILE")
    endif()
    function(json_string output value)
        if("${value}" MATCHES "\\$<")
            message(FATAL_ERROR "Cannot export unresolved generator expression: ${value}")
        endif()
        string(REPLACE "\\" "\\\\" value "${value}")
        string(REPLACE "\"" "\\\"" value "${value}")
        string(REPLACE "\n" "\\n" value "${value}")
        string(REPLACE "\r" "\\r" value "${value}")
        string(REPLACE "\t" "\\t" value "${value}")
        set(${output} "\"${value}\"" PARENT_SCOPE)
    endfunction()
    function(json_array output)
        set(items)
        foreach(item IN LISTS ARGN)
            json_string(encoded "${item}")
            list(APPEND items "${encoded}")
        endforeach()
        string(REPLACE ";" ",\n    " items "${items}")
        set(${output} "[\n    ${items}\n  ]" PARENT_SCOPE)
    endfunction()
    set(groups_set_variable "BTSTACK_INFO_${example_suffix}_GROUPS_SET")
    if(NOT ${groups_set_variable})
        message(FATAL_ERROR "No source-group metadata registered for '${example}' on ${BTSTACK_INFO_PORT}")
    endif()
    set(groups_variable "BTSTACK_INFO_${example_suffix}_GROUPS")
    set(components_variable "BTSTACK_INFO_${example_suffix}_COMPONENTS")
    json_array(groups_json ${${groups_variable}})
    json_array(components_json ${${components_variable}})
    set(sources_variable "BTSTACK_INFO_${example_suffix}_SOURCES")
    set(includes_variable "BTSTACK_INFO_${example_suffix}_INCLUDE_DIRECTORIES")
    json_string(port_json "${BTSTACK_INFO_PORT}")
    json_string(application_json "${example}")
    json_array(sources_json ${${sources_variable}})
    json_array(includes_json ${${includes_variable}})
    json_array(configuration_json ${BTSTACK_INFO_CONFIGURATION_MACROS})
    file(WRITE "${OUTPUT_FILE}" "{\n  \"schema_version\": 2,\n  \"port\": ${port_json},\n  \"application\": ${application_json},\n  \"configuration\": ${configuration_json},\n  \"sources\": ${sources_json},\n  \"groups\": ${groups_json},\n  \"components\": ${components_json},\n  \"include_directories\": ${includes_json}\n}\n")
    message(STATUS "Wrote ${OUTPUT_FILE}")
    return()
endif()

if(${status_variable})
    message(STATUS "BTstack application '${example}' is included for port ${BTSTACK_INFO_PORT}")
    set(sources_variable "BTSTACK_INFO_${example_suffix}_SOURCES")
    set(include_directories_variable "BTSTACK_INFO_${example_suffix}_INCLUDE_DIRECTORIES")
    set(defines_variable "BTSTACK_INFO_${example_suffix}_DEFINES")
    message(STATUS "Capability compile definitions: ${${defines_variable}}")
    message(STATUS "Include directories:")
    foreach(include_directory IN LISTS ${include_directories_variable})
        message(STATUS "  ${include_directory}")
    endforeach()
    message(STATUS "Source files:")
    foreach(source IN LISTS ${sources_variable})
        message(STATUS "  ${source}")
    endforeach()
else()
    message(STATUS "BTstack application '${example}' is excluded for port ${BTSTACK_INFO_PORT}")
    set(config_variable "BTSTACK_INFO_${example_suffix}_MISSING_CONFIGURATION")
    set(capabilities_variable "BTSTACK_INFO_${example_suffix}_MISSING_CAPABILITIES")
    if(${config_variable})
        message(STATUS "  Missing configuration: ${${config_variable}}")
    endif()
    if(${capabilities_variable})
        message(STATUS "  Missing port capabilities: ${${capabilities_variable}}")
    endif()
endif()
