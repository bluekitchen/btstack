# List all declared examples independently of a port's configuration.
if(NOT BTSTACK_ROOT)
    get_filename_component(BTSTACK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
include("${BTSTACK_ROOT}/tool/cmake/BTstack.cmake")
include("${BTSTACK_ROOT}/example/requirements.cmake")

foreach(example IN LISTS btstack_declared_examples)
    set(groups)
    set(configuration)
    foreach(requirement IN LISTS btstack_example_${example}_needs)
        if(requirement IN_LIST btstack_source_groups)
            list(APPEND groups "${requirement}")
        elseif(requirement MATCHES "^ENABLE_[A-Z0-9_]+$")
            list(APPEND configuration "${requirement}")
        endif()
        # Port capabilities such as audio and led do not select a radio mode.
    endforeach()
    if(groups)
        btstack_collect_group_configuration_requirements(group_configuration GROUPS ${groups})
        list(APPEND configuration ${group_configuration})
    endif()
    if("ENABLE_BLE" IN_LIST configuration AND "ENABLE_CLASSIC" IN_LIST configuration)
        list(APPEND examples_dual_mode "${example}")
    elseif("ENABLE_BLE" IN_LIST configuration)
        list(APPEND examples_le_only "${example}")
    elseif("ENABLE_CLASSIC" IN_LIST configuration)
        list(APPEND examples_classic_only "${example}")
    else()
        list(APPEND examples_core "${example}")
    endif()
endforeach()

function(list_examples title examples)
    message("==== ${title} ====")
    foreach(item IN LISTS ${examples})
        message(" - ${item}")
    endforeach()
endfunction()

list_examples("Core Examples"         examples_core)
list_examples("Classic-only Examples" examples_classic_only)
list_examples("LE-only Examples"      examples_le_only)
list_examples("Dual-Mode Examples"    examples_dual_mode)
