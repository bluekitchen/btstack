cmake_minimum_required(VERSION 3.18)
set(groups_script "${CMAKE_CURRENT_LIST_DIR}/../../tool/cmake/BTstackGroups.cmake")

function(check_command expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN} -P "${groups_script}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(text "${output}${error}")
    if(NOT result EQUAL 0 OR NOT text MATCHES "${expected}")
        message(FATAL_ERROR "Unexpected group command result (${result}):\n${text}")
    endif()
    set(command_output "${text}" PARENT_SCOPE)
endfunction()

check_command("platform-posix-run-loop" -DMODE=list -DFILTER=RUN-LOOP)
if(NOT command_output MATCHES "platform-embedded-run-loop" OR command_output MATCHES "transport-h4")
    message(FATAL_ERROR "Group list filter returned unexpected groups: ${command_output}")
endif()
check_command("ENABLE_BLE" -DMODE=info -DGROUP=gatt-server)
foreach(expected IN ITEMS "Description: GATT server" "att-dispatch" "src/ble/att_server.c")
    if(NOT command_output MATCHES "${expected}")
        message(FATAL_ERROR "Group detail missing '${expected}': ${command_output}")
    endif()
endforeach()
check_command("platform/posix" -DMODE=info -DGROUP=platform-posix-run-loop)
check_command("No groups match" -DMODE=list -DFILTER=not-a-real-group)
execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=info -DGROUP=not-a-real-group -P "${groups_script}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Unknown BTstack source group")
    message(FATAL_ERROR "Unknown group did not report the expected error: ${error}")
endif()
